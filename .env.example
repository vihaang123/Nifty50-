# Copy this file to ".env" and fill in real values ONLY where noted. The ".env" file is git-ignored.
# Never commit real credentials. Credentials live on the backend only, never in the browser/frontend.

# --- API settings (Phase 8A). Set these in the shell or your host's environment settings. ---
# Browser origin(s) allowed to call the API (CORS). Comma separated. In production set this to the deployed frontend origin.
FRONTEND_ORIGIN=http://localhost:3000
# development or production. Production refuses a wildcard origin and requires FRONTEND_ORIGIN to be set.
ENVIRONMENT=development

# --- Data provider (Phase 8D) ---
# local (default) reads the CSV/Parquet price file. angel_one is reserved for Phase 8E: selecting it now returns a clear
# "not implemented" error and never falls back to local data. Leave unset to use config.yaml (local).
DATA_PROVIDER=local
# Optional: price file for the local provider. Relative paths start at the project root. Leave unset for config.yaml's file.
# DATA_PATH=data/raw/dev_prices_synthetic.csv

# --- Angel One SmartAPI (Phase 8E). Placeholders only; nothing in the project reads these yet. ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
