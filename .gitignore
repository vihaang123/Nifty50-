# Secrets: never commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Generated data (the small synthetic dev files in data/raw ARE committed)
data/processed/*
!data/processed/.gitkeep

# Frontend build output and test artifacts (frontend/.gitignore also covers these inside frontend/)
node_modules/
.next/
coverage/
htmlcov/

# Packaged snapshots and temporary files
*.zip
screenshots/

# OS / editor
.DS_Store
.vscode/
.idea/
